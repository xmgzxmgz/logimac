{
  "name": "logimac",
  "version": "1.0.0",
  "description": "Logitech mouse manager for macOS with web UI",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npx vite",
    "start": "tsx server/index.ts",
    "build": "cd client && npx vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-hid": "^3.1.0",
    "socket.io": "^4.7.5",
    "usb": "^3.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "node-hid@3.3.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
